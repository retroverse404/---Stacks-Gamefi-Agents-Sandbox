# Convex
VITE_CONVEX_URL=https://your-project.convex.cloud
VITE_X402_API_URL=https://your-x402-host.example.com
VITE_APP_ENV=preview
VITE_ENABLE_GITHUB_AUTH=false

# Local judge/dev session defaults (frontend-only)
# VITE_RUNTIME_FREE_SESSION_MINUTES=5
# VITE_RUNTIME_PAID_SESSION_MINUTES=5

# Convex Auth (set these in the Convex dashboard environment variables)
# AUTH_GITHUB_ID=your_github_oauth_app_id
# AUTH_GITHUB_SECRET=your_github_oauth_app_secret
# SITE_URL=http://localhost:5173

# Braintrust (set in Convex dashboard environment variables)
# BRAINTRUST_API_KEY=your_braintrust_api_key
